<Window x:Class="Player64X.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player 64X" Width="1280" Height="760" MinWidth="640" MinHeight="400"
        Background="#0B0B0D" AllowDrop="True" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Drop="Window_Drop" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#E8E8EC"/>
        <SolidColorBrush x:Key="Dim" Color="#8A8A94"/>
        <SolidColorBrush x:Key="Accent" Color="#3DA5FF"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 영상 영역 -->
        <Grid x:Name="Stage" ClipToBounds="True" Background="Black"
              MouseWheel="Stage_MouseWheel" MouseLeftButtonDown="Stage_MouseDown"
              MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_MouseUp"
              MouseDown="Stage_AnyMouseDown">
            <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          ScrubbingEnabled="True" Stretch="Uniform" IsHitTestVisible="False"
                          RenderTransformOrigin="0.5,0.5"
                          MediaOpened="Video_Opened" MediaEnded="Video_Ended" MediaFailed="Video_Failed">
                <MediaElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="FitT"/>
                        <ScaleTransform x:Name="StretchT"/>
                        <ScaleTransform x:Name="FlipT"/>
                        <RotateTransform x:Name="RotT"/>
                        <ScaleTransform x:Name="ZoomT"/>
                        <TranslateTransform x:Name="PanT"/>
                    </TransformGroup>
                </MediaElement.RenderTransform>
            </MediaElement>
            <TextBlock x:Name="Hint" Text="영상 파일을 여기로 끌어놓거나 [열기] 를 누르세요" FontSize="16"
                       Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
            <TextBlock x:Name="Osd" Text="" FontSize="22" Foreground="White" Margin="24,18" Opacity="0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.9"/></TextBlock.Effect>
            </TextBlock>
        </Grid>

        <!-- 컨트롤 바 -->
        <Border x:Name="Bar" VerticalAlignment="Bottom" Background="#E6121215" Padding="12,8,12,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeCur" Text="00:00" Width="62" Foreground="{StaticResource Dim}"/>
                    <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            Focusable="False" ValueChanged="Seek_Changed" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimeTot" Grid.Column="2" Text="00:00" Width="62" TextAlignment="Right" Foreground="{StaticResource Dim}"/>
                </Grid>
                <DockPanel LastChildFill="False">
                    <Button Content="열기" Click="Open_Click"/>
                    <Button x:Name="PlayBtn" Content="재생" Width="52" Click="Play_Click"/>
                    <Button Content="-10s" Click="Back_Click"/>
                    <Button Content="+10s" Click="Fwd_Click"/>
                    <Border Width="1" Background="#2A2A30" Margin="8,2"/>
                    <Button Content="회전" Click="Rotate_Click" ToolTip="90도 회전 (R)"/>
                    <Button Content="좌우반전" Click="Flip_Click" ToolTip="H"/>
                    <Button x:Name="AspectBtn" Content="비율: 원본" Click="Aspect_Click" ToolTip="화면 비율 바꿔서 옆으로 늘리기 (A)"/>
                    <Button Content="−" FontSize="16" Padding="12,2" Click="ZoomOut_Click" ToolTip="축소 ( - )"/>
                    <Button x:Name="ZoomBtn" Content="100%" Width="62" Click="ZoomReset_Click" ToolTip="클릭하면 초기화 (0)"/>
                    <Button Content="+" FontSize="16" Padding="12,2" Click="ZoomIn_Click" ToolTip="확대 ( + )"/>
                    <Button x:Name="SpeedBtn" Content="1.0x" Width="52" Click="Speed_Click" ToolTip="재생 속도 ([ ])"/>
                    <Button Content="전체화면" DockPanel.Dock="Right" Click="Full_Click"/>
                    <Slider x:Name="Vol" DockPanel.Dock="Right" Width="90" Minimum="0" Maximum="1" Value="0.8"
                            Focusable="False" ValueChanged="Vol_Changed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="볼륨" DockPanel.Dock="Right" Foreground="{StaticResource Dim}" Margin="0,0,6,0"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
